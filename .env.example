# ---- Network mode: "testnet" or "mainnet" ----
# Start with testnet, switch to mainnet only when ready to go live for the challenge.
X402_NETWORK=testnet

# ---- Shared payTo address (Composite Entry rule: ALL routes must use this SAME address) ----
# This is the single Algorand address that receives payment for every AgentHub endpoint.
# It must be opted in to USDC (ASA 31566704 on mainnet, ASA 10458941 on testnet).
RECEIVER_ADDRESS=YOUR_ALGORAND_ADDRESS_58_CHARS

# ---- GoPlausible facilitator (mandatory for competition tracking) ----
# Using any other facilitator means your volume will not count toward the leaderboard.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# ---- Server ----
PORT=3000

# ---- Anthropic API key (required by /api/inference and /api/summarize) ----
# Without it, those two routes return HTTP 502 and the server logs a warning at startup.
# /api/wallet-risk does not need it.
ANTHROPIC_API_KEY=

# ---- Algorand indexer for /api/wallet-risk (optional) ----
# Defaults to the public AlgoNode indexer for the selected network (no API key required):
#   testnet -> https://testnet-idx.algonode.cloud
#   mainnet -> https://mainnet-idx.algonode.cloud
# Set this only to override the default (e.g. a private indexer).
INDEXER_URL=

# ---- GitHub token for /api/code-review (strongly recommended) ----
# Unauthenticated GitHub allows only 60 requests/hour PER IP, shared across every
# caller of this server — not enough for a paid endpoint. Any classic token with
# public repo read access raises it to 5,000/hour.
GITHUB_TOKEN=

# ---- Paying wallet for the test scripts (test-client, run-all, optin-usdc) ----
# Not used by the server itself — only by the client scripts that pay for calls.
#
# Two formats are accepted:
#   25 words — Algorand's native mnemonic (algosdk). The phrase IS the key.
#   24 words — BIP-39, what Pera and Defly export for new accounts. The phrase is
#              a seed; the key is derived at m/44'/283'/0'/0'/0'.
#
# A 24-word phrase is NOT a 25-word phrase with the checksum word removed — they
# are different standards. When a 24-word phrase is used the scripts print the
# derived address on startup; confirm it matches your wallet before funding it,
# because a wallet using a different derivation path yields a different address
# that simply holds no funds.
AVM_CLIENT_MNEMONIC=

# ---- Derivation path override (24-word BIP-39 phrases only) ----
# Only set this if the address printed on startup does not match your wallet.
# Default: m/44'/283'/0'/0'/0'
ALGO_DERIVATION_PATH=

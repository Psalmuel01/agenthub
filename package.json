{
  "name": "agenthub",
  "version": "0.1.0",
  "description": "AgentHub - an x402-powered marketplace of paid tools for AI agents on Algorand",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "test-client": "ts-node-dev --transpile-only scripts/test-client.ts",
    "run-all": "ts-node-dev --transpile-only scripts/run-all.ts",
    "optin-usdc": "ts-node-dev --transpile-only scripts/optin-usdc.ts",
    "use-client": "ts-node-dev --transpile-only scripts/use-client.ts"
  },
  "dependencies": {
    "@x402-avm/avm": "^2.6.1",
    "@x402-avm/core": "^2.6.1",
    "@x402-avm/express": "^2.6.1",
    "@x402-avm/extensions": "^2.6.1",
    "agenthub-algo": "file:packages/agenthub-algo",
    "algosdk": "^3.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "json-bigint": "^1.0.0"
  },
  "devDependencies": {
    "@algorandfoundation/xhd-wallet-api": "^1.0.3",
    "@scure/bip39": "^1.6.0",
    "@types/express": "^4.17.21",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^20.14.0",
    "libsodium-sumo": "^0.8.4",
    "libsodium-wrappers-sumo": "^0.8.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "libsodium-sumo": "^0.8.4"
  }
}

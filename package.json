{
  "name": "agenthub",
  "version": "0.1.0",
  "description": "AgentHub - an x402-powered marketplace of paid tools for AI agents on Algorand",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test-client": "ts-node-dev --transpile-only scripts/test-client.ts",
    "optin-usdc": "ts-node-dev --transpile-only scripts/optin-usdc.ts"
  },
  "dependencies": {
    "@x402-avm/avm": "^2.6.1",
    "@x402-avm/core": "^2.6.1",
    "@x402-avm/express": "^2.6.1",
    "@x402-avm/extensions": "^2.6.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "algosdk": "^3.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
